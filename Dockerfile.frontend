# Dockerfile.frontend
FROM node:22-alpine AS builder  

# Instalar pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copiar archivos de configuración desde la raíz
COPY package.json pnpm-lock.yaml ./
COPY .npmrc ./

# Instalar dependencias
RUN pnpm install --frozen-lockfile

# Copiar todo el código fuente (incluye src/)
COPY . .

# Construir la app (usará VITE_API_URL de Render)
RUN pnpm build

# Servir con Nginx
FROM nginx:alpine

# Copiar los archivos buildidos
COPY --from=builder /app/dist /usr/share/nginx/html

# Configuración SIMPLE de Nginx (SOLO SPA, sin proxy)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
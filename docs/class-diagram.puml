@startuml
!theme plain
skinparam class {
  BackgroundColor #1e293b
  BorderColor #3b82f6
  FontColor #e2e8f0
  HeaderFontColor #3b82f6
  ArrowFontColor #94a3b8
}
skinparam arrow {
  Color #94a3b8
}
skinparam package {
  BackgroundColor #0f172a
  BorderColor #475569
  FontColor #e2e8f0
}

package "Tipos (types/)" {
  enum ComponentType {
    resistor
    capacitor
    inductor
    voltageSource
    currentSource
    switch
    led
    ground
    diode
    transistor
    potentiometer
    voltmeter
    ammeter
  }

  enum ComponentCategory {
    Fuentes
    Pasivos
    Semiconductores
    Logicos
    Medidores
    Miscelaneos
  }

  class Point {
    + x: number
    + y: number
  }

  class ParamDef {
    + id: string
    + label: string
    + min: number
    + max: number
    + step: number
    + unit: string
  }

  class CircuitComponent {
    + id: string
    + type: ComponentType
    + label: string
    + position: Point
    + rotation: number
    + params: Record<string, number>
    + terminalIds: [string, string]
  }

  class Terminal {
    + id: string
    + componentId: string
    + index: 0 | 1
    + nodeId: number
  }

  class WireDef {
    + id: string
    + fromTerminalId: string
    + toTerminalId: string
  }

  class MeasurementProbe {
    + id: string
    + label: string
    + type: 'voltage' | 'current' | 'power'
    + componentId: string
    + color: string
    + visible: boolean
  }

  class SimResults {
    + nodeVoltages: Record<number, number[]>
    + branchCurrents: Record<string, number[]>
    + timestep: number
    + time: number[]
    + status: { success: boolean, error?: string }
  }

  class CircuitState {
    + components: Record<string, CircuitComponent>
    + terminals: Record<string, Terminal>
    + wires: Record<string, WireDef>
    + nextNodeId: number
  }

  ComponentType <.. CircuitComponent : type
  ComponentCategory ..> ComponentType : agrupa
  Point *-- CircuitComponent : position
  Terminal *-- CircuitState : terminals
  CircuitComponent *-- CircuitState : components
  WireDef *-- CircuitState : wires
  CircuitComponent ..> Terminal : terminalIds >
}

package "Store (store/)" {
  class AppState {
    + circuit: CircuitState
    + selectedComponentId: string | null
    + activeTool: ComponentType | 'select' | 'wire' | 'probe'
    + connectorMode: boolean
    + connectingFrom: string | null
    + connectingTo: string | null
    + simulationRunning: boolean
    + simResults: SimResults | null
    + probes: MeasurementProbe[]
    + oscData: Record<string, Array<{t, v}>>
    + simTime: number
    + undoStack: CircuitState[]
    + redoStack: CircuitState[]
  }

  interface CircuitStore {
    + addComponent(type, pos): void
    + removeComponent(id): void
    + moveComponent(id, pos): void
    + rotateComponent(id): void
    + duplicateComponent(id): void
    + startConnection(tid): void
    + completeConnection(tid): void
    + cancelConnection(): void
    + selectComponent(id): void
    + setActiveTool(tool): void
    + setSimulationRunning(run): void
    + setSimResults(results): void
    + addProbe(type, compId): void
    + removeProbe(id): void
    + toggleProbe(id): void
    + appendOscData(probeId, t, v): void
    + clearOscData(): void
    + undo(): void
    + redo(): void
    + pushUndo(): void
  }

  AppState <.. CircuitStore : manages
  CircuitState <-- AppState
  SimResults <-- AppState
  MeasurementProbe <-- AppState
}

package "Componentes UI" {
  class CircuitEditor {
    + nodes: Node[]
    + edges: Edge[]
    + onNodesChange(): void
    + onEdgesChange(): void
    + onConnect(): void
    + onDrop(): void
    + onNodeClick(): void
  }

  class ComponentNode {
    + data: { component, selected, isLit }
    + handles: Handle[]
  }

  class Toolbar {
    + busqueda: string
    + categoriaActiva: string
    + onDragStart(): void
  }

  class PropertiesPanel {
    + parametros: ParamDef[]
    + mediciones: { V, I, P }
    + onRotar(): void
    + onDuplicar(): void
    + onEliminar(): void
  }

  class MultimeterDisplay {
    + voltage: string
    + current: string
    + power: string
  }

  class GraphPanel {
    + traces: PlotlyTrace[]
    + onToggleProbe(): void
    + onLimpiar(): void
  }

  class SimulationStatus {
    + estado: 'running' | 'error' | 'processing' | 'stopped'
    + tiempo: string
    + alertaTierra: boolean
  }

  class CalculatorPage {
    + tabActivo: number
    + calcularOhm(): void
    + calcularColores(): void
    + calcularRC(): void
    + calcularXLXC(): void
  }

  CircuitEditor *-- ComponentNode : renderiza
  Toolbar ..> CircuitEditor : drag & drop
  PropertiesPanel ..> CircuitEditor : seleccion
  MultimeterDisplay ..> CircuitStore : suscribe
  GraphPanel ..> CircuitStore : oscData
  SimulationStatus ..> CircuitStore : simResults
  CalculatorPage ..> CircuitStore : independiente
}

package "Backend Python" {
  class FastAPIApp {
    + POST /api/simulate
    + POST /api/validate
    + GET /api/status
  }

  class MnaEngine {
    - G: numpy.ndarray
    - B: numpy.ndarray
    - solve(circuit): SimResults
    - stampResistor(): void
    - stampCapacitor(): void
    - stampInductor(): void
    - stampVoltageSource(): void
    - stampLed(): void
    - stampDiode(): void
  }

  class SpiceBuilder {
    + buildNetlist(circuit): string
    + runNgspice(netlist): SimResults
  }

  class CircuitValidator {
    + validate(circuit): ValidationResult
    - bfsGroundCheck(): boolean
    - checkShortCircuit(): boolean
    - checkFloatingNodes(): boolean
  }

  FastAPIApp ..> MnaEngine : usa
  FastAPIApp ..> SpiceBuilder : alternativa
  FastAPIApp ..> CircuitValidator : valida
}

' Conexiones
CircuitStore <.. CircuitEditor : subscribe
CircuitStore <.. Toolbar : subscribe
CircuitStore <.. PropertiesPanel : subscribe
CircuitStore <.. MultimeterDisplay : subscribe
CircuitStore <.. GraphPanel : subscribe
CircuitStore <.. SimulationStatus : subscribe

@enduml

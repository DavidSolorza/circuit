@startuml
!theme plain
skinparam rectangle {
  BackgroundColor #1e293b
  BorderColor #3b82f6
  FontColor #e2e8f0
}
skinparam package {
  BackgroundColor #0f172a
  BorderColor #475569
  FontColor #e2e8f0
}
skinparam arrow {
  Color #94a3b8
  FontColor #94a3b8
}
skinparam node {
  BackgroundColor #334155
  BorderColor #64748b
  FontColor #e2e8f0
}
skinparam interface {
  BackgroundColor #1e3a5f
  BorderColor #3b82f6
  FontColor #93c5fd
}
skinparam database {
  BackgroundColor #1a2e1a
  BorderColor #22c55e
  FontColor #86efac
}

title "Arquitectura de LabCircuitos"

package "Frontend React" as FELAYER {

  package "UI Components" as UILAYER {
    rectangle Toolbar as TOOLBAR
    rectangle CircuitEditor as EDITOR
    rectangle ComponentNode as NODE
    rectangle PropertiesPanel as PROPS
    rectangle MultimeterDisplay as METER
    rectangle GraphPanel as GRAPH
    rectangle CalculatorPage as CALC
    rectangle SimulationStatus as STATUS
  }

  package "Store (Zustand)" as STORE {
    interface CircuitStoreActions as ACTIONS {
      addComponent / removeComponent
      startConnection / completeConnection
      setSimulationRunning / setSimResults
      undo / redo
      addProbe / removeProbe
    }

    database AppState as STATE {
      CircuitState
      SimResults
      MeasurementProbe[]
      herramienta activa
      simulación corriendo
    }
  }

  package "Hooks" as HOOKS {
    node useSimulation as SIMLOOP {
      requestAnimationFrame
      fetch /api/simulate
    }
  }

  TOOLBAR --> ACTIONS : dispatch
  EDITOR --> ACTIONS : dispatch
  PROPS --> ACTIONS : dispatch
  ACTIONS --> STATE : set state
  STATE <-- EDITOR : subscribe
  STATE <-- METER : subscribe
  STATE <-- GRAPH : subscribe
  STATE <-- STATUS : subscribe
  EDITOR *-- NODE : custom node
  METER --> STATE : read V/I/P
  GRAPH --> STATE : read oscData
}

package "Backend Python (FastAPI)" as BKLAYER {
  rectangle "REST API\n/api/simulate\n/api/validate\n/api/status" as API

  package "Simulation Engine" as SIMENGINE {
    node "MNA Engine\n(numpy)" as MNA {
      Modified Nodal Analysis
      Backward Euler
      numpy.linalg.solve
    }
    node "SPICE Bridge\n(PySpice/Ngspice)" as SPICE {
      Netlist generation
      Ngspice subprocess
    }
  }

  rectangle "Validator\n(BFS ground, floats,\ncortocircuitos)" as VALIDATOR

  API --> MNA : solve(circuit)
  API --> SPICE : run(netlist)
  API --> VALIDATOR : validate(circuit)
}

' Flujo de datos frontend-backend
SIMLOOP --> API : POST /api/simulate (JSON)
API --> SIMLOOP : SimResults (JSON)
SIMLOOP --> ACTIONS : setSimResults
ACTIONS --> STATE : actualiza

' Flujo de osciloscopio
ACTIONS --> STATE : appendOscData
STATE --> GRAPH : re-render traces

' Dependencias
NODE --> STATE : read component params
PROPS --> STATE : read/write selected
METER --> STATE : latest V/I/P
STATUS --> STATE : sim status + time
CALC ..> CALC : standalone

@enduml
